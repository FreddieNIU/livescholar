# 功能：提供本地运行所需的环境变量模板；复制为 .env 后填写真实凭据。
LIVE_SCHOLAR_EMAIL_TO=you@example.com
LIVE_SCHOLAR_EMAIL_FROM=livescholar@example.com
LIVE_SCHOLAR_SMTP_HOST=smtp.example.com
LIVE_SCHOLAR_SMTP_PORT=587
LIVE_SCHOLAR_SMTP_USERNAME=livescholar@example.com
LIVE_SCHOLAR_SMTP_PASSWORD=change-me

# Optional discovery/verification APIs.
SERPAPI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
